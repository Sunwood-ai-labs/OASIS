# WebUI Draft folder path
# WebUIでアップロードしたファイルの保存先（デフォルト: $WORKSPACE/draft）
WEBUI_DRAFT_DIR=C:/Prj/OASIS/draft

# -----------------------------------------
# WordPress設定
#
# WordPress APIの認証に使用するユーザー名
# WordPress管理画面で作成したアプリケーションパスワードのユーザー名を指定
AUTH_USER=XXXX
# WordPress APIの認証に使用するアプリケーションパスワード
# WordPress管理画面で生成したアプリケーションパスワードを指定（スペースで区切られた4つの文字列）
AUTH_PASS=XXXX XXXX XXXX XXXX
# WordPressサイトのベースURL
# https://から始まる完全なURLを指定
BASE_URL=https://XXXX.com
# 1つの投稿に設定できるタグの最大数（デフォルト: 50）
MAX_COUNT_TAG=50
# 1つの投稿に設定できるカテゴリの最大数（デフォルト: 10）
MAX_COUNT_CAT=10

# -----------------------------------------
# LLM設定
#
# 使用するLLMモデル（デフォルト: gemini/gemini-1.5-pro-latest）
LLM_MODEL=gemini/gemini-1.5-pro-latest
# LLMリクエストの最大リトライ回数（デフォルト: 10）
MAX_RETRIES=10

# -----------------------------------------
# AI API設定
#
# Google の Gemini AI モデルを使用するためのAPIキー
# LLMによる自動カテゴリ・タグ提案機能に使用
GEMINI_API_KEY=XXXXX

# -----------------------------------------
# Qiita設定
#
# Qiita APIを使用するためのアクセストークン
# QiitaのアカウントページでAPI認証用のトークンを生成して設定
QIITA_TOKEN=XXXXX
# Qiitaの記事を公開設定で投稿するかどうか（true/false、デフォルト: false）
QIITA_POST_PUBLISH=false

# -----------------------------------------
# Note設定
#
# Noteのアカウントに関連付けられたメールアドレス
NOTE_EMAIL=your_email@example.com
# Noteアカウントのパスワード
NOTE_PASSWORD=your_password
# NoteのユーザーID
NOTE_USER_ID=your_user_id
# Noteの記事を公開設定で投稿するかどうか（true/false、デフォルト: false）
NOTE_PUBLISH=false
# NoteのAPIバージョン（デフォルト: v2）
NOTE_API_VER=v2

# -----------------------------------------
# Zenn設定
#
# ZennAPI V2で記事ファイルを生成する出力フォルダ
ZENN_OUTPUT_PATH=C:/Prj/Zenn/articles
# ZennAPI V2で記事を公開設定にするかどうか（true/false、デフォルト: false）
ZENN_PUBLISH=false

# -----------------------------------------
# Firefox設定
#
# Firefox の実行ファイルへのパス（任意）
FIREFOX_BINARY_PATH=C:/Program Files/Mozilla Firefox/firefox.exe
# 使用する Firefox プロファイルへのパス（任意）
FIREFOX_PROFILE_PATH=C:/Users/username/AppData/Roaming/Mozilla/Firefox/Profiles/your_profile
# Firefoxのヘッドレスモードを使用するかどうか（true/false、デフォルト: false）
FIREFOX_HEADLESS=false

# -----------------------------------------
# Firefox の設定 (必要であれば設定してください)
# FIREFOX_BINARY_PATH="C:\Program Files\Mozilla Firefox\firefox.exe"
# FIREFOX_PROFILE_PATH="C:\Users\makim\AppData\Roaming\Mozilla\Firefox\Profiles\your_profile_name"

# 注意:
# - このファイルには機密情報が含まれるため、.gitignoreに追加してバージョン管理システムにコミットされないようにしてください。
# - 実際の値に置き換える際は、XXXXの部分を適切な値に変更してください。
# - 環境に応じて、MAX_COUNT_TAGとMAX_COUNT_CATの値を調整してください。
# - GEMINI_API_KEYとQIITA_TOKENは、それぞれのサービスから取得する必要があります。
#   使用しない機能がある場合は、対応する項目を削除または無視しても構いません。
# - EMAIL、PASSWORD、USER_IDは、Noteアカウントの認証情報です。適切な値を設定してください。
# - Firefox の設定は必須ではありません。設定しない場合はデフォルト値が使用されます。
